{
  "release": "0.5.0",
  "policy": "upstream sources remain replaceable; only plugins/adapters depend on public extension contracts",
  "validated_snapshots": {
    "openclaw": {
      "version": "2026.9.3",
      "required_contracts": [
        "plugin-sdk/plugin-entry",
        "plugin-sdk/control-ui",
        "registerGatewayMethod",
        "session.controls.registerControlUiDescriptor",
        "extensions/* workspace"
      ]
    },
    "weknora": {
      "version": "0.8.0",
      "required_contracts": [
        "knowledge base CRUD",
        "knowledge document listing",
        "Wiki API",
        "tenant members",
        "knowledge-base shares",
        "knowledge-base activity",
        "JWT/API-key identity headers"
      ]
    },
    "openviking": {
      "openclaw_plugin_version": "2026.6.18",
      "required_contracts": [
        "official OpenClaw context-engine plugin",
        "sessions API",
        "search/find API",
        "skills list/find/read API",
        "trusted account/user headers"
      ]
    }
  }
}
