{
  "plugins": {
    "entries": {
      "leeclaw-knowledge": {
        "enabled": true,
        "config": {
          "weknoraBaseUrl": "http://weknora:8080",
          "graphApiBaseUrl": "http://leeclaw-graph-api:8090",
          "workspaceRegistryPath": "/etc/leeclaw/workspaces.json",
          "workspaceStatePath": "/var/lib/leeclaw/workspaces.state.json",
          "uploadMaxBytes": 10485760,
          "auditLogPath": "/var/lib/leeclaw/knowledge-audit.jsonl"
        }
      },
      "leeclaw-openviking": {
        "enabled": true,
        "config": {
          "baseUrl": "http://openviking:1933",
          "apiKey": "${OPENVIKING_ROOT_API_KEY}",
          "workspaceRegistryPath": "/etc/leeclaw/workspaces.json",
          "workspaceStatePath": "/var/lib/leeclaw/workspaces.state.json",
          "memoryRuntimeEnabled": true,
          "memoryRecallLimit": 8,
          "memoryMaxRecallChars": 12000,
          "commitPendingTokens": 1200,
          "commitKeepRecentCount": 6
        }
      }
    }
  }
}
