# LeeClaw Core / Ontology Registry v0.8
COBRA_ONTOLOGY_REGISTRY_ROOT=/app/data/ontology-registry
COBRA_REGISTRY_ADMIN_TOKEN=replace-with-a-long-random-token

# Core API
COBRA_GRAPH_API_LISTEN=:8090
COBRA_WEKNORA_BASE_URL=http://weknora:8080
COBRA_CATALOG_OVERLAY_FILE=/etc/leeclaw/semantic-overlay.json
LEECLAW_RUNTIME_TOKEN=replace-with-a-separate-long-random-runtime-token

# Entity Graph source
COBRA_NEO4J_URL=http://neo4j:7474
COBRA_NEO4J_USER=neo4j
COBRA_NEO4J_PASSWORD=replace-me
COBRA_GRAPH_AUTH_MODE=weknora

# OpenClaw plugin workspace mappings refer to per-workspace variables like:
WEKNORA_API_KEY_CHONGQING=replace-with-weknora-tenant-service-key
WEKNORA_API_KEY_HQ=replace-with-weknora-tenant-service-key
