# CobraKnowledge v0.4+ Ontology Registry
COBRA_ONTOLOGY_REGISTRY_ROOT=/app/data/ontology-registry
COBRA_REGISTRY_ADMIN_TOKEN=replace-with-a-long-random-token

# WeKnora Graph authorization delegation
COBRA_WEKNORA_BASE_URL=http://weknora:8080
COBRA_GRAPH_AUTH_MODE=weknora

# Optional graph service settings
COBRA_GRAPH_API_LISTEN=:8090
COBRA_GRAPH_CORS_ORIGIN=
