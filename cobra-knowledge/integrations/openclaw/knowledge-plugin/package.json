{
  "name": "openclaw-plugin-leeclaw-knowledge",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "OpenClaw-native knowledge workspace backed by WeKnora using the durable OpenClaw user profile as the only user identity.",
  "scripts": {
    "build": "openclaw plugins build",
    "validate": "openclaw plugins validate --json",
    "pack": "openclaw plugins pack --json",
    "test": "node --test test/*.test.js"
  },
  "files": [
    "index.js",
    "lib",
    "browser",
    "openclaw.plugin.json",
    "README.md"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.9.3"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "controlUi": "./browser/index.js",
    "compat": {
      "pluginApi": ">=2026.9.3"
    }
  }
}
