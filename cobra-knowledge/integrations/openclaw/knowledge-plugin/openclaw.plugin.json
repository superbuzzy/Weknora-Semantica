{
  "id": "leeclaw-knowledge",
  "name": "LeeClaw Knowledge",
  "description": "OpenClaw-native knowledge management backed by WeKnora, with entity/ontology graph views.",
  "version": "0.6.0",
  "activation": { "onStartup": true },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "weknoraBaseUrl": { "type": "string" },
      "weknoraApiKey": { "type": "string" },
      "weknoraTenantId": { "type": ["string", "number"] },
      "workspaceId": { "type": "string" },
      "graphApiBaseUrl": { "type": "string" },
      "requestTimeoutMs": { "type": "number", "minimum": 1000, "maximum": 60000 }
    },
    "required": ["weknoraBaseUrl", "weknoraApiKey", "weknoraTenantId", "workspaceId"]
  }
}
